# Optional: enables DeepSeek query rewriting, generated answers, and LLM evaluation.
# Leave blank to use cited extractive answers. Keep this value local; .env is ignored by Git.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_JUDGE_MODEL=deepseek-chat

# Hugging Face models are downloaded and cached on first use.
HF_HOME=/app/.cache/huggingface
